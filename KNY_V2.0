local pages, tabs = {}, {}
local function OpenPage(name)
	for k, p in pairs(pages) do p.Visible = (k == name) end
	for k, b in pairs(tabs) do b.BackgroundColor3 = (k == name) and Pal.Red or Pal.Bg end
end

local function AddPage(name, ord)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -10, 0, 30)
	b.BackgroundColor3 = Pal.Bg
	b.Font = Enum.Font.GothamBold
	b.Text = name
	b.TextColor3 = Pal.Txt
	b.TextSize = 10
	b.LayoutOrder = ord
	b.Parent = Side
	Rad(b, 6)

	local sf = Instance.new("ScrollingFrame")
	sf.Size = UDim2.fromScale(1, 1)
	sf.BackgroundTransparency = 1
	sf.ScrollBarThickness = 3
	sf.Visible = false
	sf.CanvasSize = UDim2.new(0, 0, 0, 0)
	sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
	sf.Parent = Body
	local ul = Instance.new("UIListLayout"); ul.Padding = UDim.new(0, 5); ul.SortOrder = Enum.SortOrder.LayoutOrder; ul.Parent = sf

	pages[name], tabs[name] = sf, b
	b.MouseButton1Click:Connect(function() OpenPage(name) end)
	return sf
end

local pGen = AddPage("General", 1)
local pVip = AddPage("VIP / OP", 2)
local pVis = AddPage("Visual", 3)
OpenPage("General")

local St = {
	Safe = false, Speed = 16, Jump = 50, Air = false, Void = false, Fast = false, Afk = false,
	Hitbox = false, HbSz = 9, Aim = false, AimFov = 150, CamL = false,
	Fly = false, FlySpd = 55, Noclip = false, Spin = false, SpinSpd = 18,
	Esp = false, Rag = false, Fps = false,
	Fov = 70, Zoom = false, Bright = false, NoFog = false
}

-- 2. Registro de setters para sincronizar botones al resetear
local ToggleSetters = {}

-- 6. Caché de partes para Noclip sin GetDescendants() por frame
local noclipParts = {}
local function RebuildNoclipCache(char)
	table.clear(noclipParts)
	if not char then return end
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then
			table.insert(noclipParts, p)
		end
	end
end
RebuildNoclipCache(lp.Character)

local function ApplyNoclipState(enable)
	for _, p in ipairs(noclipParts) do
		if p and p.Parent then
			p.CanCollide = not enable
		end
	end
end

-- 5. ESP estable con Highlight por jugador
local espHighlights = {}
local function ClearAllEsp()
	for plr, hl in pairs(espHighlights) do
		pcall(function() if hl then hl:Destroy() end end)
		espHighlights[plr] = nil
	end
end

local function UpdatePlayerHighlight(plr)
	if plr == lp then return end
	local shouldShow = St.Esp and St.Safe and (KeySys.Tier == "VIP")
	if not shouldShow then
		if espHighlights[plr] then
			pcall(function() espHighlights[plr]:Destroy() end)
			espHighlights[plr] = nil
		end
		return
	end
	if plr.Character then
		local hl = espHighlights[plr]
		if not hl or not hl.Parent then
			hl = Instance.new("Highlight")
			hl.Name = "KNY_ESP_HL"
			hl.FillColor = Pal.Red
			hl.OutlineColor = Pal.Gold
			hl.FillTransparency = 0.65
			hl.OutlineTransparency = 0.1
			hl.Adornee = plr.Character
			hl.Parent = Gui
			espHighlights[plr] = hl
		else
			hl.Adornee = plr.Character
		end
	end
end

local function SyncAllEsp()
	for _, plr in ipairs(Players:GetPlayers()) do
		UpdatePlayerHighlight(plr)
	end
end

On(Players.PlayerAdded:Connect(function(plr)
	On(plr.CharacterAdded:Connect(function()
		task.wait(0.2)
		UpdatePlayerHighlight(plr)
	end))
end))

On(Players.PlayerRemoving:Connect(function(plr)
	if espHighlights[plr] then
		pcall(function() espHighlights[plr]:Destroy() end)
		espHighlights[plr] = nil
	end
end))

local hbSaved = {}
local function ClearHb()
	for p, d in pairs(hbSaved) do
		pcall(function()
			if p and p.Parent then
				p.Size = d.s; p.Transparency = d.t; p.CanCollide = d.c
			end
		end)
	end
	table.clear(hbSaved)
end

local function SyncHb()
	if not St.Hitbox or not St.Safe or KeySys.Tier ~= "VIP" then ClearHb(); return end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= lp and plr.Character then
			local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				if not hbSaved[hrp] then
					hbSaved[hrp] = { s = hrp.Size, t = hrp.Transparency, c = hrp.CanCollide }
				end
				pcall(function()
					hrp.Size = Vector3.new(St.HbSz, St.HbSz, St.HbSz)
					hrp.Transparency = 0.78
					hrp.CanCollide = false
				end)
			end
		end
	end
end

-- 3. SyncHum reaplicable tras reaparecer
local speedStepSetter, jumpStepSetter = nil, nil
local function SyncHum()
	local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
	if not h then return end
	h.WalkSpeed = St.Speed
	if h.UseJumpPower then h.JumpPower = St.Jump else h.JumpHeight = math.max(1, math.floor(St.Jump * 0.14)) end
end

local function ApplyFastPrompts()
	pcall(function()
		for _, desc in ipairs(workspace:GetDescendants()) do
			if desc:IsA("ProximityPrompt") then
				desc.HoldDuration = St.Fast and 0 or 0.5
			end
		end
	end)
end

local function ApplyFpsBoost(on)
	pcall(function()
		Lighting.GlobalShadows = not on
		settings().Rendering.QualityLevel = on and Enum.QualityLevel.Level01 or Enum.QualityLevel.Automatic
	end)
end

local function UpdateAssistOverlays()
	local vipActive = St.Safe and (KeySys.Tier == "VIP")
	FlyPad.Visible = vipActive and St.Fly
	if not FlyPad.Visible then
		flyUpHeld = false
		flyDownHeld = false
	end

	local aimActive = vipActive and St.Aim
	FovCircle.Visible = aimActive
	FovCircle.Size = UDim2.new(0, St.AimFov * 2, 0, St.AimFov * 2)
	fovStroke.CornerRadius = UDim.new(0, St.AimFov)
	AimHoldBtn.Visible = aimActive
	if not aimActive then
		aimHoldTouch = false
	end
end

local function Tog(parent, ord, name, isNew, vipOnly, cb)
	local f = Instance.new("Frame")
	f.Size = UDim2.new(1, -4, 0, isNew and 44 or 32)
	f.BackgroundColor3 = Pal.Card
	f.LayoutOrder = ord
	f.Parent = parent
	Rad(f, 6)

	if isNew then
		local nt = Instance.new("TextLabel")
		nt.Size = UDim2.new(0, 32, 0, 12)
		nt.Position = UDim2.new(0, 8, 0, 2)
		nt.BackgroundColor3 = Pal.Cyan
		nt.Font = Enum.Font.GothamBlack
		nt.Text = "NEW"
		nt.TextColor3 = Pal.Bg
		nt.TextSize = 8
		nt.Parent = f
		Rad(nt, 3)
	end

	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, -72, 1, isNew and -12 or 0)
	l.Position = UDim2.new(0, 8, 0, isNew and 12 or 0)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBold
	l.Text = name
	l.TextColor3 = vipOnly and Pal.Gold or Pal.Txt
	l.TextSize = 10
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = f

	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0, 54, 0, 20)
	b.Position = UDim2.new(1, -60, 0.5, -10)
	b.BackgroundColor3 = Pal.Bg
	b.Font = Enum.Font.GothamBlack
	b.Text = "OFF"
	b.TextColor3 = Pal.Txt
	b.TextSize = 9
	b.Parent = f
	Rad(b, 5)

	local cur = false
	local function Paint(state)
		cur = state
		b.Text = cur and "ON" or "OFF"
		b.BackgroundColor3 = cur and (vipOnly and Pal.Gold or Pal.Red) or Pal.Bg
		b.TextColor3 = cur and Pal.Bg or Pal.Txt
	end

	table.insert(ToggleSetters, { name = name, paint = Paint })

	b.MouseButton1Click:Connect(function()
		if vipOnly and KeySys.Tier ~= "VIP" then Notify("VIP", "Requiere Key VIP/OP.", Pal.Gold); return end
		local nv = not cur
		if cb(nv) ~= false then
			Paint(nv)
			Notify(name, cur and "ON" or "OFF", cur and Pal.Green or Pal.Sub)
		end
	end)
end

local function Step(parent, ord, name, init, mn, mx, stp, vipOnly, cb)
	local f = Instance.new("Frame")
	f.Size = UDim2.new(1, -4, 0, 32)
	f.BackgroundColor3 = Pal.Card
	f.LayoutOrder = ord
	f.Parent = parent
	Rad(f, 6)

	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, -110, 1, 0)
	l.Position = UDim2.new(0, 8, 0, 0)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBold
	l.Text = name
	l.TextColor3 = Pal.Txt
	l.TextSize = 10
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = f

	local vl = Instance.new("TextLabel")
	vl.Size = UDim2.new(0, 36, 0, 20)
	vl.Position = UDim2.new(1, -68, 0.5, -10)
	vl.BackgroundColor3 = Pal.Bg
	vl.Font = Enum.Font.GothamBlack
	vl.Text = tostring(init)
	vl.TextColor3 = Pal.Green
	vl.TextSize = 9
	vl.Parent = f
	Rad(vl, 4)

	local mb = Instance.new("TextButton")
	mb.Size = UDim2.new(0, 20, 0, 20)
	mb.Position = UDim2.new(1, -90, 0.5, -10)
	mb.BackgroundColor3 = Pal.Bg
	mb.Font = Enum.Font.GothamBold
	mb.Text = "-"
	mb.TextColor3 = Pal.Txt
	mb.Parent = f
	Rad(mb, 4)

	local pb = Instance.new("TextButton")
	pb.Size = UDim2.new(0, 20, 0, 20)
	pb.Position = UDim2.new(1, -28, 0.5, -10)
	pb.BackgroundColor3 = Pal.Bg
	pb.Font = Enum.Font.GothamBold
	pb.Text = "+"
	pb.TextColor3 = Pal.Txt
	pb.Parent = f
	Rad(pb, 4)

	local v = init
	local function SetV(nv)
		v = math.clamp(nv, mn, mx)
		vl.Text = tostring(v)
		cb(v)
	end
	mb.MouseButton1Click:Connect(function() if vipOnly and KeySys.Tier ~= "VIP" then return end; SetV(v - stp) end)
	pb.MouseButton1Click:Connect(function() if vipOnly and KeySys.Tier ~= "VIP" then return end; SetV(v + stp) end)
	return SetV
end

-- General
Tog(pGen, 1, "Seguro Activo", false, false, function(v)
	St.Safe = v
	if not v then
		St.Speed = 16; St.Jump = 50; St.Air = false; St.Void = false
		St.Hitbox = false; St.Aim = false; St.CamL = false; St.Fly = false; St.Noclip = false; St.Spin = false; St.Esp = false
		ApplyNoclipState(false)
		ClearHb()
		SyncAllEsp()
		UpdateAssistOverlays()
		if speedStepSetter then speedStepSetter(16) end
		if jumpStepSetter then jumpStepSetter(50) end
		SyncHum()
		for _, item in ipairs(ToggleSetters) do
			if item.name ~= "Seguro Activo" then
				item.paint(false)
			end
		end
	else
		UpdateAssistOverlays()
	end
	return true
end)
Tog(pGen, 2, "Impulso Aéreo", false, false, function(v) if v and not St.Safe then return false end; St.Air = v; return true end)
Tog(pGen, 3, "Anti-Void", true, false, function(v) St.Void = v; return true end)
Tog(pGen, 4, "Fast Prompt", true, false, function(v) St.Fast = v; ApplyFastPrompts(); return true end)
Tog(pGen, 5, "Anti-AFK", false, false, function(v) St.Afk = v; return true end)
speedStepSetter = Step(pGen, 6, "Velocidad", 16, 10, 64, 4, false, function(v) if St.Safe then St.Speed = v; SyncHum() end end)
jumpStepSetter = Step(pGen, 7, "Salto", 50, 30, 120, 5, false, function(v) if St.Safe then St.Jump = v; SyncHum() end end)

-- VIP / OP (sin relleno inútil; Aimbot y Cam Lock diferenciados)
Tog(pVip, 1, "Hitbox Expander", false, true, function(v) if v and not St.Safe then return false end; St.Hitbox = v; SyncHb(); return true end)
Step(pVip, 2, "Tamaño Hitbox", 9, 4, 20, 1, true, function(v) St.HbSz = v; SyncHb() end)
Tog(pVip, 3, "Aimbot (Hold + FOV)", false, true, function(v) if v and not St.Safe then return false end; St.Aim = v; UpdateAssistOverlays(); return true end)
Step(pVip, 4, "FOV Aimbot", 150, 60, 340, 20, true, function(v) St.AimFov = v; UpdateAssistOverlays() end)
Tog(pVip, 5, "Cam Lock", true, true, function(v) if v and not St.Safe then return false end; St.CamL = v; return true end)
Tog(pVip, 6, "ESP Box", true, true, function(v) if v and not St.Safe then return false end; St.Esp = v; SyncAllEsp(); return true end)
Tog(pVip, 7, "Fly", false, true, function(v) if v and not St.Safe then return false end; St.Fly = v; UpdateAssistOverlays(); return true end)
Step(pVip, 8, "Velocidad Fly", 55, 20, 140, 10, true, function(v) St.FlySpd = v end)
Tog(pVip, 9, "Noclip", false, true, function(v)
	if v and not St.Safe then return false end
	St.Noclip = v
	RebuildNoclipCache(lp.Character)
	ApplyNoclipState(v)
	return true
end)
Tog(pVip, 10, "Spinbot", false, true, function(v) if v and not St.Safe then return false end; St.Spin = v; return true end)
Step(pVip, 11, "Vel Spinbot", 18, 5, 50, 5, true, function(v) St.SpinSpd = v end)
Tog(pVip, 12, "Anti-Ragdoll", false, true, function(v) St.Rag = v; return true end)
Tog(pVip, 13, "FPS Boost OP", false, true, function(v) St.Fps = v; ApplyFpsBoost(v); return true end)

-- Visual
Step(pVis, 1, "FOV Cámara", 70, 60, 110, 5, false, function(v) St.Fov = v; if workspace.CurrentCamera then workspace.CurrentCamera.FieldOfView = v end end)
Tog(pVis, 2, "Zoom Amplio", false, false, function(v) St.Zoom = v; lp.CameraMaxZoomDistance = v and 1000 or 128; return true end)
Tog(pVis, 3, "FullBright", false, false, function(v) St.Bright = v; Lighting.Brightness = v and 2.5 or 1; return true end)
Tog(pVis, 4, "Sin Niebla", false, false, function(v) St.NoFog = v; Lighting.FogEnd = v and 100000 or 500; return true end)

On(lp.CharacterAdded:Connect(function(newChar)
	task.wait(0.25)
	RebuildNoclipCache(newChar)
	if St.Safe then
		SyncHum()
	end
	if St.Noclip and St.Safe and KeySys.Tier == "VIP" then
		ApplyNoclipState(true)
	end
end))

On(UserInputService.JumpRequest:Connect(function()
	if St.Air and St.Safe and lp.Character then
		local hrp = lp.Character:FindFirstChild("HumanoidRootPart")
		if hrp then hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 60, hrp.AssemblyLinearVelocity.Z) end
	end
end))

On(lp.Idled:Connect(function()
	if St.Afk then
		pcall(function()
			local vu = game:GetService("VirtualUser")
			vu:CaptureController()
			vu:ClickButton2(Vector2.zero)
		end)
	end
end))

local function IsEnemy(plr)
	if plr == lp then return false end
	if lp.Team and plr.Team and plr.Team == lp.Team then
		return false
	end
	return true
end

local function FindAimTarget(maxDist)
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local mid = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)
	local best, bd = nil, maxDist or math.huge
	for _, plr in ipairs(Players:GetPlayers()) do
		if IsEnemy(plr) and plr.Character then
			local h2 = plr.Character:FindFirstChildOfClass("Humanoid")
			local hd = plr.Character:FindFirstChild("Head")
			if h2 and h2.Health > 0 and hd then
				local sp, vis = cam:WorldToViewportPoint(hd.Position)
				if vis and sp.Z > 0 then
					local d = (Vector2.new(sp.X, sp.Y) - mid).Magnitude
					if d < bd then bd = d; best = hd end
				end
			end
		end
	end
	return best
end

-- Carga 20s con rotación del avatar 3D
task.spawn(function()
	local t0 = os.clock()
	while LoadScreen and LoadScreen.Parent do
		local el = os.clock() - t0
		local p = math.clamp(el / 20, 0, 1)
		LoadBarFill.Size = UDim2.new(p, 0, 1, 0)
		LoadStatus.Text = string.format("Cargando 3D: %d%% (%.1fs)", math.floor(p * 100), math.max(0, 20 - el))
		if AvatarPivot.PrimaryPart then
			AvatarPivot:PivotTo(CFrame.new(0, 0, 0) * CFrame.Angles(0, el * 1.4, 0))
		end
		if p >= 1 then break end
		task.wait(0.05)
	end
	if LoadScreen and LoadScreen.Parent then LoadScreen:Destroy() end
	KeyWin.Visible = true
	Notify("KNY V2.0", "Carga 3D completa.", Pal.Green)
end)

local hbAcc, tMove = 0, 0
On(RunService.RenderStepped:Connect(function(dt)
	tMove += dt
	if LoadScreen and LoadScreen.Parent then
		TitleMove.Position = UDim2.new(0.5, -110 + math.sin(tMove * 2.5) * 35, 0.1, math.cos(tMove * 3) * 6)
	end

	if phase == "RUN" and Gui.Parent then
		local reqS = isVipMode and 35 or 12
		local reqT = isVipMode and 25 or 10
		local el = os.clock() - tStart
		local pinOk = KeySys.Pin8 ~= nil and Pin8In.Text == KeySys.Pin8
		local vipOk = (not isVipMode) or (stepOk1 and stepOk2 and stepOk3 and KeySys.VipCode ~= nil and VipCodeIn.Text == KeySys.VipCode)
		if el >= reqS and taps >= reqT and pinOk and vipOk then
			phase = "DONE"
			local nk = GenKey(isVipMode and "KVIP" or "K9", isVipMode)
			if isVipMode then KeySys.Vip = nk else KeySys.Normal = nk end
			KeyInput.Text = nk
			TrialAction.Text = "KEY: " .. nk
			KeyMsg.Text = "Key lista de 1 uso. Tócala para copiar o entra."
			pcall(function() if type(setclipboard) == "function" then setclipboard(nk) end end)
			Notify("Key Lista", nk, Pal.Green)
		end
	end

	local ch = lp.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if St.Safe and hrp and hum then
		if St.Void and hrp.Position.Y < -45 then
			hrp.AssemblyLinearVelocity = Vector3.new(0, 75, 0)
		end
		if KeySys.Tier == "VIP" then
			if St.Spin then
				hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(St.SpinSpd), 0)
			end
			if St.Noclip then
				ApplyNoclipState(true)
			end
			if St.Fly then
				local vy = 0
				if flyUpHeld or UserInputService:IsKeyDown(Enum.KeyCode.Space) then vy = St.FlySpd end
				if flyDownHeld or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vy = -St.FlySpd end
				hrp.AssemblyLinearVelocity = Vector3.new(hum.MoveDirection.X * St.FlySpd, vy, hum.MoveDirection.Z * St.FlySpd)
			end
			if St.Rag and hum:GetState() == Enum.HumanoidStateType.Physics then
				hum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end

			local cam = workspace.CurrentCamera
			local holdingAim = aimHoldTouch or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
			if St.Aim and holdingAim and cam then
				local tgt = FindAimTarget(St.AimFov)
				if tgt then
					cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, tgt.Position), 0.22)
				end
			elseif St.CamL and cam then
				local tgt = FindAimTarget(math.huge)
				if tgt then
					cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, tgt.Position), 0.45)
				end
			end
		end
	end

	hbAcc += dt
	if hbAcc >= 1.2 then
		hbAcc = 0
		SyncHb()
	end
end))

KX.MouseButton1Click:Connect(function() KeyWin.Visible = false; FloatBtn.Visible = true end)
CloseBtn.MouseButton1Click:Connect(function() Main.Visible = false; FloatBtn.Visible = true end)
MinBtn.MouseButton1Click:Connect(function()
	local m = Side.Visible
	Side.Visible = not m; Body.Visible = not m
	Main.Size = m and UDim2.new(0, 520, 0, 38) or UDim2.new(0, 520, 0, 340)
	MinBtn.Text = m and "+" or "-"
end)

FloatBtn.MouseButton1Click:Connect(function()
	FloatBtn.Visible = false
	if KeySys.Tier == "NONE" then KeyWin.Visible = true else Main.Visible = true end
end)

EnterBtn.MouseButton1Click:Connect(function()
	local k = KeyInput.Text:gsub("[%s%c]", ""):upper()
	if k == "" or KeySys.Used[k] then Notify("Key", "Inválida o ya usada.", Pal.Red); return end
	if k == KeySys.Vip then
		KeySys.Used[k] = true; KeySys.Vip = nil; KeySys.Tier = "VIP"; KeyInput.Text = ""
		MainTitle.Text = "KNY V2.0 • VIP / OP"; KeyWin.Visible = false; Main.Visible = true
		SyncAllEsp()
		UpdateAssistOverlays()
		Notify("VIP / OP", "Opciones OP activas.", Pal.Gold)
	elseif k == KeySys.Normal then
		KeySys.Used[k] = true; KeySys.Normal = nil; KeySys.Tier = "NORMAL"; KeyInput.Text = ""
		MainTitle.Text = "KNY V2.0 • NORMAL"; KeyWin.Visible = false; Main.Visible = true
		Notify("Normal", "Key quemada tras 1 uso.", Pal.Green)
	else
		Notify("Key", "No coincide con ninguna key activa.", Pal.Red)
	end
end)

On(Gui.Destroying:Connect(function()
	ClearHb()
	ClearAllEsp()
	ApplyNoclipState(false)
	for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
end))
