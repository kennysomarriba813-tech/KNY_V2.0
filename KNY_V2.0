local NotifArea = Instance.new("Frame")
NotifArea.Size = UDim2.new(0, 250, 0, 165)
NotifArea.Position = UDim2.new(1, -260, 1, -175)
NotifArea.BackgroundTransparency = 1
NotifArea.Parent = Gui

local nList = Instance.new("UIListLayout")
nList.FillDirection = Enum.FillDirection.Vertical
nList.VerticalAlignment = Enum.VerticalAlignment.Bottom
nList.HorizontalAlignment = Enum.HorizontalAlignment.Right
nList.SortOrder = Enum.SortOrder.LayoutOrder
nList.Padding = UDim.new(0, 5)
nList.Parent = NotifArea

local nCount = 0
local function Notify(title, msg, col)
	nCount += 1
	local lb = Instance.new("TextLabel")
	lb.Size = UDim2.new(1, 0, 0, 34)
	lb.LayoutOrder = nCount
	lb.BackgroundColor3 = Pal.Card2
	lb.TextColor3 = col or Pal.Txt
	lb.Font = Enum.Font.GothamBold
	lb.TextSize = 10
	lb.TextWrapped = true
	lb.Text = title .. ": " .. msg
	lb.Parent = NotifArea
	Rad(lb, 6)
	Stroke(lb, col or Pal.Red, 1)
	task.delay(2.5, function() pcall(function() lb:Destroy() end) end)
end

-- Sistema de keys de 1 solo uso + PIN de 8 dígitos
local KeySys = {
	Normal = nil,
	Vip = nil,
	Pin8 = nil,
	VipCode = nil,
	Used = {},
	Tier = "NONE"
}

local kSeq = 0
local function GenKey(prefix, isVip)
	local k = ""
	repeat
		kSeq += 1
		local uid = tonumber(lp.UserId) or 100
		local mix = kSeq * 157 + math.random(1000, 9999) + (uid % 977)
		k = string.format("%s-%04d-%04d-%04d", prefix, ((mix * 19) % 8999) + 1000, ((mix * 37) % 8999) + 1000, ((mix * 53 + (isVip and 777 or 333)) % 8999) + 1000)
	until not KeySys.Used[k]
	return k
end

local function GenPin8()
	local s = ""
	for _ = 1, 8 do s ..= tostring(math.random(0, 9)) end
	return s
end

