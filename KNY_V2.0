AvatarPivot.Parent = VpFrame

local function Build3DAvatarPreview()
	for _, c in ipairs(AvatarPivot:GetChildren()) do c:Destroy() end
	AvatarPivot.PrimaryPart = nil

	local char = lp.Character
	if char then
		pcall(function()
			char.Archivable = true
			local clone = char:Clone()
			for _, obj in ipairs(clone:GetDescendants()) do
				if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") or obj:IsA("BillboardGui") or obj:IsA("Sound") then
					obj:Destroy()
				elseif obj:IsA("BasePart") then
					obj.Anchored = true
					obj.CanCollide = false
				end
			end
			for _, part in ipairs(clone:GetChildren()) do
				part.Parent = AvatarPivot
			end
			clone:Destroy()

			local root = AvatarPivot:FindFirstChild("HumanoidRootPart") or AvatarPivot:FindFirstChildWhichIsA("BasePart")
			if root then
				AvatarPivot.PrimaryPart = root
				AvatarPivot:PivotTo(CFrame.new(0, 0, 0))
			end
		end)
	end

	if not AvatarPivot.PrimaryPart then
		for _, c in ipairs(AvatarPivot:GetChildren()) do c:Destroy() end
		local torso = Instance.new("Part")
		torso.Name = "HumanoidRootPart"
		torso.Size = Vector3.new(2, 2.2, 1)
		torso.Position = Vector3.new(0, 0, 0)
		torso.Color = Pal.Card2
		torso.Anchored = true
		torso.Parent = AvatarPivot

		local head = Instance.new("Part")
		head.Name = "Head"
		head.Size = Vector3.new(1.2, 1.2, 1.2)
		head.Position = Vector3.new(0, 1.75, 0)
		head.Color = Pal.Txt
		head.Anchored = true
		head.Parent = AvatarPivot

		AvatarPivot.PrimaryPart = torso
	end

	VpCam.CFrame = CFrame.new(Vector3.new(0, 1.1, 6.2), Vector3.new(0, 0.8, 0))
end

Build3DAvatarPreview()
On(lp.CharacterAdded:Connect(function()
	task.wait(0.25)
	Build3DAvatarPreview()
end))

