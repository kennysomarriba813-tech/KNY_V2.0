KeyMsg.TextXAlignment = Enum.TextXAlignment.Left
KeyMsg.LayoutOrder = 6
KeyMsg.Parent = KScroll

local isVipMode, phase, tStart, taps, lastTap = false, "IDLE", 0, 0, 0

local function ResetSteps()
	stepOk1, stepOk2, stepOk3 = false, false, false
	for _, c in ipairs(StepsBox:GetChildren()) do
		if c:IsA("TextButton") then
			c.Text = c.Text:sub(1, 6)
			c.TextColor3 = Pal.Sub
		end
	end
end

local function SetMode(vip)
	isVipMode = vip; phase = "IDLE"; taps = 0
	KeySys.Pin8 = nil; KeySys.VipCode = nil
	Pin8In.Text = ""; VipCodeIn.Text = ""; ResetSteps()
	VipCodeIn.Visible = vip; StepsBox.Visible = vip
	NormTab.BackgroundColor3 = vip and Pal.Card or Pal.Red
	VipTab.BackgroundColor3 = vip and Color3.fromRGB(70, 55, 20) or Pal.Card
	TrialAction.Text = vip and "PRUEBA VIP (35s • 25 toques)" or "PRUEBA NORMAL (12s • 10 toques)"
	KeyMsg.Text = vip and "VIP: 35s, 25 toques, pasos 1-2-3, PIN 8 y código VIP." or "Normal: 12s, 10 toques y PIN 8."
end

NormTab.MouseButton1Click:Connect(function() SetMode(false) end)
VipTab.MouseButton1Click:Connect(function() SetMode(true) end)

TrialAction.MouseButton1Click:Connect(function()
	local needT = isVipMode and 25 or 10
	if phase == "IDLE" then
		phase = "RUN"; tStart = os.clock(); taps = 0
		KeySys.Pin8 = GenPin8()
		KeySys.VipCode = isVipMode and tostring(math.random(100000, 999999)) or nil
		Pin8In.Text = ""; VipCodeIn.Text = ""; ResetSteps()
		PinDisplay.Text = "PIN 8: " .. KeySys.Pin8 .. (KeySys.VipCode and (" | VIP: " .. KeySys.VipCode) or "")
		TrialAction.Text = "TOCAR (0/" .. tostring(needT) .. ")"
		Notify("Prueba", "PIN de 8 dígitos listo.", Pal.Green)
	elseif phase == "RUN" then
		if os.clock() - lastTap < 0.07 then return end
		lastTap = os.clock(); taps += 1
		if taps < needT then
			TrialAction.Text = "TOCAR (" .. tostring(taps) .. "/" .. tostring(needT) .. ")"
		else
			TrialAction.Text = "COMPLETA TIEMPO Y PIN"
		end
	elseif phase == "DONE" then
		pcall(function() if type(setclipboard) == "function" then setclipboard(KeyInput.Text) end end)
		Notify("Key", "Copiada: " .. KeyInput.Text, Pal.Green)
	end
end)

