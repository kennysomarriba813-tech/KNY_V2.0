local stepOk1, stepOk2, stepOk3 = false, false, false
for i = 1, 3 do
	local sb = Instance.new("TextButton")
	sb.Size = UDim2.new(0.32, -2, 1, 0)
	sb.Position = UDim2.new((i - 1) * 0.34, 0, 0, 0)
	sb.BackgroundColor3 = Pal.Bg
	sb.Font = Enum.Font.GothamBold
	sb.Text = "PASO " .. tostring(i)
	sb.TextColor3 = Pal.Sub
	sb.TextSize = 9
	sb.Parent = StepsBox
	Rad(sb, 5)
	sb.MouseButton1Click:Connect(function()
		if i == 1 and not stepOk1 then stepOk1 = true; sb.Text = "1 OK"; sb.TextColor3 = Pal.Green
		elseif i == 2 and stepOk1 and not stepOk2 then stepOk2 = true; sb.Text = "2 OK"; sb.TextColor3 = Pal.Green
		elseif i == 3 and stepOk1 and stepOk2 and not stepOk3 then stepOk3 = true; sb.Text = "3 OK"; sb.TextColor3 = Pal.Green
		else Notify("Pasos", "Orden: 1, 2, 3", Pal.Red) end
	end)
end

