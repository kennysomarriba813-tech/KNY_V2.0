-- KNY V2.0 - Base Optimizada + 8 Fallos Corregidos + Sin Relleno

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local lp = Players.LocalPlayer
if not lp then
	Players.PlayerAdded:Wait()
	lp = Players.LocalPlayer
end

local function GetGuiRoot()
	local ok1, hui = pcall(function()
		return type(gethui) == "function" and gethui() or nil
	end)
	if ok1 and typeof(hui) == "Instance" then return hui end

	local ok2, cg = pcall(function()
		local g = game:GetService("CoreGui")
		local f = Instance.new("Folder")
		f.Parent = g
		f:Destroy()
		return g
	end)
	if ok2 and cg then return cg end

	return lp:FindFirstChildOfClass("PlayerGui") or lp:WaitForChild("PlayerGui", 10)
end

local Root = GetGuiRoot()
if not Root then return end

pcall(function()
	local old = Root:FindFirstChild("KNY_V20")
	if old then old:Destroy() end
end)

local Gui = Instance.new("ScreenGui")
Gui.Name = "KNY_V20"
Gui.ResetOnSpawn = false
Gui.IgnoreGuiInset = true
Gui.Parent = Root

local Conns = {}
local function On(c) table.insert(Conns, c); return c end

local Pal = {
	Bg = Color3.fromRGB(11, 14, 21),
	Card = Color3.fromRGB(21, 26, 38),
	Card2 = Color3.fromRGB(28, 35, 50),
	Red = Color3.fromRGB(198, 34, 64),
	Gold = Color3.fromRGB(216, 170, 56),
	Green = Color3.fromRGB(34, 168, 122),
	Cyan = Color3.fromRGB(56, 176, 206),
	Txt = Color3.fromRGB(224, 230, 240),
	Sub = Color3.fromRGB(146, 158, 176)
}

local function Rad(obj, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 8)
	c.Parent = obj
end

local function Stroke(obj, col, th)
	local s = Instance.new("UIStroke")
	s.Color = col
	s.Thickness = th or 1
	s.Parent = obj
end

local function Drag(handle, target)
	local down, inpObj, p0, u0 = false, nil, Vector2.zero, target.Position
	On(handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			down = true; inpObj = i; p0 = i.Position; u0 = target.Position
			i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End and inpObj == i then down = false; inpObj = nil end
			end)
		end
	end))
	On(UserInputService.InputChanged:Connect(function(i)
		if down and i == inpObj and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - p0
			target.Position = UDim2.new(u0.X.Scale, u0.X.Offset + d.X, u0.Y.Scale, u0.Y.Offset + d.Y)
		end
	end))
end

